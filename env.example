# ---------------------------------------------------------------------------
# SIDIKIDS AI — variables d'environnement (modèle, sans aucun secret)
# Copier ce fichier en `.env` à la racine, puis remplir les valeurs.
#
# IMPORTANT : sans les deux variables VITE_SUPABASE_*, l'application démarre en
# MODE DÉMONSTRATION (contenus locaux, progression dans le navigateur).
# ---------------------------------------------------------------------------

# URL du projet Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=

# Clé publique "anon" (Project Settings > API > anon public).
# Ne jamais placer la clé service_role ici : tout ce qui commence par VITE_ est
# visible dans le navigateur.
VITE_SUPABASE_ANON_KEY=

# `demo` force le mode démonstration même si Supabase est configuré.
# `auto` (défaut) : Supabase si configuré, sinon démonstration.
VITE_APP_MODE=auto

# Base des fichiers audio (facultatif).
# Vide = /audio/<langue>/<clé>.mp3 servi depuis public/
VITE_AUDIO_BASE_URL=
